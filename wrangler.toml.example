name = "oida-pilot-web"
main = "cloudflare/worker.js"
compatibility_date = "2026-08-30"

[assets]
directory = "./dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = ["/api/*", "/health", "/ready"]

[vars]
API_ORIGIN = "https://replace-with-backend.example.com"
